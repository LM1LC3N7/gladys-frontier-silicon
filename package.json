{
  "name": "gladys-frontier-silicon",
  "version": "0.1.1",
  "private": true,
  "description": "Frontier Silicon internet radios (Roberts, Hama, Medion, Revo, Lenco...) for Gladys Assistant, on the local network through FSAPI: power, volume, source, presets and now playing, scene triggers, scene actions and a dashboard widget.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-frontier-silicon.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
